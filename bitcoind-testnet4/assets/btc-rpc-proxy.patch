 /// - **verbosity 2**: wants prevout data, which needs the undo files a pruned
 ///   node has also discarded
 /// - **anything malformed**: Core writes better argument errors than this would
+/// The two arguments `getblock` needs, taken from either the positional or the
+/// named spelling of its params. The verbosity is returned exactly as sent;
+/// `getblock_verbosity` normalizes the boolean form bitcoind and Fulcrum use.
+fn getblock_args(params: &GenericRpcParams) -> Option<(Value, Value)> {
+    match params {
+        GenericRpcParams::Array(a) => Some((
+            a.first()?.clone(),
+            a.get(1).cloned().unwrap_or_else(|| Value::from(1_u64)),
+        )),
+        GenericRpcParams::Object(o) => Some((
+            o.get("blockhash")?.clone(),
+            o.get("verbosity")
+                .cloned()
+                .unwrap_or_else(|| Value::from(1_u64)),
+        )),
+    }
+}
+
+/// Core accepts `0`/`1` and `false`/`true` for getblock's verbosity; the fetch
+/// serves only the raw (0) and header-bearing (1) forms.
+fn getblock_verbosity(value: &Value) -> Option<u8> {
+    match value {
+        Value::Bool(false) => Some(0),
+        Value::Bool(true) => Some(1),
+        Value::Number(n) if n.as_u64() == Some(0) => Some(0),
+        Value::Number(n) if n.as_u64() == Some(1) => Some(1),
+        Value::Null => Some(1),
+        _ => None,
+    }
+}
